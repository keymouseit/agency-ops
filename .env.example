# The database is created automatically at prisma/agency-ops.db
# when you run: npx prisma db push
DATABASE_URL="file:./agency-ops.db"

# Required for NextAuth session signing. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# If you ever move to a hosted database (e.g. Turso, PlanetScale),
# update DATABASE_URL and prisma/schema.prisma accordingly.

# Google Calendar Integration
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="founder@example.com"
# OR base64 encoded JSON key file
GOOGLE_CREDENTIALS_BASE64=""

# Optional company branding (defaults to KeyMouse IT)
NEXT_PUBLIC_COMPANY_NAME="KeyMouse IT"
NEXT_PUBLIC_COMPANY_INITIALS="KI"
NEXT_PUBLIC_COMPANY_TAGLINE="Internal operations platform"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
HR_EMAIL="hr@example.com"
