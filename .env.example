# The database is created automatically at prisma/agency-ops.db
# when you run: npx prisma db push
DATABASE_URL="file:./agency-ops.db"

# Required for NextAuth session signing. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"

# If you ever move to a hosted database (e.g. Turso, PlanetScale),
# update DATABASE_URL and prisma/schema.prisma accordingly.

# Google Calendar — approved leaves
# Leave this as the Google account email you want events on (e.g. you@gmail.com).
# Without GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY, Agency Ops emails a calendar invite there via SMTP.
GOOGLE_CALENDAR_ID="you@company.com"
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_CREDENTIALS_BASE64=""

# Optional company branding (defaults to KeyMouse IT)
NEXT_PUBLIC_COMPANY_NAME="KeyMouse IT"
NEXT_PUBLIC_COMPANY_INITIALS="KI"
NEXT_PUBLIC_COMPANY_TAGLINE="Internal operations platform"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
HR_EMAIL="leaves@keymouseit.com,shiven@keymouseit.com"

# Optional: temporary password used only by local seed / account setup scripts
# SEED_DEFAULT_PASSWORD="set-locally-do-not-commit"

# Optional Prisma pool size (default 5). Keep low for Neon free tier / local Next.js.
# PRISMA_CONNECTION_LIMIT=5
